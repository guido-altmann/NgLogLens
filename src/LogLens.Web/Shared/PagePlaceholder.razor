@* Platzhalter für die noch leeren Seiten aus SPEC 8. Wird pro Meilenstein ersetzt. *@

<PageTitle>@Title – LogLens</PageTitle>

<MudText Typo="Typo.h1" GutterBottom="true" Style="font-size:2rem;">@Title</MudText>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
    Diese Ansicht entsteht in Meilenstein @Milestone.
</MudAlert>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Milestone { get; set; } = string.Empty;
}
